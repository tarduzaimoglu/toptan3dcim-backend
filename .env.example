# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=<required-in-production>
BACKEND_URL=<required>
FRONTEND_URL=<required>

# Strapi secrets
APP_KEYS=change-me,change-me,change-me,change-me
ADMIN_JWT_SECRET=change-me
API_TOKEN_SALT=change-me
TRANSFER_TOKEN_SALT=change-me
ENCRYPTION_KEY=change-me
JWT_SECRET=change-me

# Database
# Production requires DATABASE_CLIENT=postgres and a non-empty DATABASE_URL.
DATABASE_CLIENT=postgres
DATABASE_URL=<required>

# Optional individual database settings supported by config/database.ts.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=<required>
# DATABASE_SCHEMA=public
# DATABASE_CONNECTION_TIMEOUT=60000
# DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# DATABASE_SSL_KEY=<optional>
# DATABASE_SSL_CERT=<optional>
# DATABASE_SSL_CA=<optional>
# DATABASE_SSL_CAPATH=<optional>
# DATABASE_SSL_CIPHER=<optional>
# DATABASE_FILENAME=.tmp/data.db

# Supabase S3-compatible storage
SUPABASE_PUBLIC_URL=<required>
SUPABASE_S3_ACCESS_KEY_ID=<required>
SUPABASE_S3_SECRET_ACCESS_KEY=<required>
SUPABASE_S3_REGION=<required>
SUPABASE_S3_ENDPOINT=<required>
SUPABASE_S3_BUCKET=<required>

# Yapı Kredi Posnet
POSNET_MERCHANT_ID=<required>
POSNET_TERMINAL_ID=<required>
POSNET_ID=<required>
POSNET_ENCKEY=<required>
POSNET_XML_URL=<required>
POSNET_OOS_URL=<required>
# Enable only after bank test confirms agreement access and XID/orderID mapping.
POSNET_AGREEMENT_ENABLED=false
POSNET_AGREEMENT_XID_PREFIX=

# Strapi admin flags
FLAG_NPS=true
FLAG_PROMOTE_EE=true

# Customer accounts (opt-in; same BFF secret/origin on frontend and backend)
CUSTOMER_ACCOUNTS_ENABLED=false
CUSTOMER_SCHEMA_SETUP=false
CUSTOMER_BFF_SECRET=
CUSTOMER_TOKEN_ENCRYPTION_KEY=
CUSTOMER_PUBLIC_ORIGIN=http://127.0.0.1:3210
# file is a controlled LOCAL mailbox only; production requires smtp
CUSTOMER_MAIL_MODE=smtp
CUSTOMER_SMTP_HOST=
CUSTOMER_SMTP_PORT=465
CUSTOMER_SMTP_USER=
CUSTOMER_SMTP_PASS=
CUSTOMER_MAIL_FROM=
# Figurine requests are opt-in. Seed managed package records only during a planned schema rollout.
FIGURINE_REQUESTS_ENABLED=false
FIGURINE_STORAGE_DRIVER=s3
FIGURINE_PRIVATE_S3_ENDPOINT=
FIGURINE_PRIVATE_S3_INTERNAL_ENDPOINT=
FIGURINE_PRIVATE_S3_BUCKET=
FIGURINE_PRIVATE_S3_REGION=
FIGURINE_PRIVATE_S3_ACCESS_KEY_ID=
FIGURINE_PRIVATE_S3_SECRET_ACCESS_KEY=
FIGURINE_MAX_FILE_BYTES=10485760
FIGURINE_MAX_FILES=10
FIGURINE_MAX_TOTAL_BYTES=52428800
FIGURINE_MAX_PIXELS=40000000
FIGURINE_ADMIN_ROLE_NAMES=
FIGURINE_REVIEW_ROLE_NAMES=
FIGURINE_QUOTE_ROLE_NAMES=
FIGURINE_OPERATIONS_ROLE_NAMES=
FIGURINE_PHOTO_ROLE_NAMES=
# Figurine payments stay unavailable unless merchant verification is completed and both gates are enabled.
FIGURINE_PAYMENTS_ENABLED=false
POSNET_BANK_VERIFIED=false
# Local development only: keeps notification messages in .tmp/figurine-mail.
FIGURINE_MAIL_MODE=smtp
MARKETING_CONSENT_ENABLED=false
MARKETING_CONSENT_TEXT_VERSION=
MARKETING_CONSENT_APPROVED_TEXT=
FIGURINE_TEMP_UPLOAD_RETENTION_HOURS=
FIGURINE_UNSUBMITTED_DRAFT_RETENTION_DAYS=
CUSTOMER_RETENTION_EXECUTION_ENABLED=false
CUSTOMER_DATA_ADMIN_ROLE_NAMES=
