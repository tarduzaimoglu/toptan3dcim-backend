{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "indexes": [{"name":"orders_checkout_key_unique","columns":["checkout_key"],"type":"unique"},{"name":"orders_figurine_offer_key_unique","columns":["figurine_offer_key"],"type":"unique"}],
  "pluginOptions": { "content-manager": { "visible": false }, "content-type-builder": { "visible": false } },
  "attributes": {
    "checkoutKey": {"type":"string","private":true},
    "checkoutHash": {"type":"string","private":true},
    "guestHash": {"type":"string","private":true},
    "billingAddress": {"type":"json"},
    "cartSnapshot": {"type":"json","private":true},
    "cartSettled": {"type":"boolean","default":false,"private":true},
    "paymentState": {"type":"enumeration","enum":["pending","paid","failed","unknown"]},
    "fulfillmentState": {"type":"enumeration","enum":["preparing","production","ready","shipped","delivered","cancelled"]},
    "deliveredAt": {"type":"datetime"},
    "cancelledAt": {"type":"datetime"},
    "shippingCarrier": {"type":"string"},
    "trackingNumber": {"type":"string"},
    "trackingUrl": {"type":"string"},
    "orderNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "paid", "failed", "cancelled"],
      "default": "pending",
      "required": true
    },
    "items": {
      "type": "json",
      "required": true
    },
    "subtotal": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "discountTotal": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "vatTotal": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "shippingCost": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "grandTotal": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "currency": {
      "type": "string",
      "required": true,
      "default": "TRY"
    },
    "buyerName": {
      "type": "string",
      "required": true
    },
    "buyerEmail": {
      "type": "email",
      "required": true
    },
    "buyerPhone": {
      "type": "string",
      "required": true
    },
    "shippingAddress": {
      "type": "json"
    },
    "contractAccepted": {
      "type": "boolean",
      "required": true,
      "default": false
    },
    "contractAcceptedAt": {
      "type": "datetime"
    },
    "posnetXid": {
      "type": "string",
      "unique": true
    },
    "ykbRefNo": {
      "type": "string"
    },
    "authCode": {
      "type": "string"
    },
    "hostlogkey": {
      "type": "string"
    },
    "bankResponseRaw": {
      "type": "json"
    },
    "clientIp": {
      "type": "string"
    },
    "figurineOfferKey": { "type": "string", "private": true },
    "figurineSnapshot": { "type": "json", "private": true },
    "fulfillmentCustomerNote": { "type": "text" },
    "fulfillmentInternalNote": { "type": "text", "private": true },
    "figurineRequest": { "type": "relation", "relation": "manyToOne", "target": "api::figurine-request.figurine-request", "private": true },
    "figurineOffer": { "type": "relation", "relation": "oneToOne", "target": "api::figurine-offer.figurine-offer", "private": true },
    "figurineReturnRequests": { "type": "relation", "relation": "oneToMany", "target": "api::figurine-return-request.figurine-return-request", "mappedBy": "order", "private": true },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
